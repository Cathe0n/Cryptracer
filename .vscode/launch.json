{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cryptracer (no debugger)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "noDebug": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Cryptracer",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Cryptracer (no browser tab)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "CRYPTRACER_NO_BROWSER": "1"
      }
    },
    {
      "name": "Import TSV into Neo4j (--import)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "args": ["--import"],
      "console": "integratedTerminal"
    }
  ]
}
